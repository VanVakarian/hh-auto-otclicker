{
  "manifest_version": 3,
  "name": "HH Auto Otclicker",
  "version": "1.8.0",
  "minimum_chrome_version": "130",
  "description": "Расширение для автоматических откликов на вакансии на HH.",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "sidePanel",
    "scripting",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "https://hh.ru/*",
    "https://*.hh.ru/*",
    "https://openrouter.ai/*",
    "https://app.vslav.dev/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content-scripts/*.js",
        "lib/*.js"
      ],
      "matches": [
        "https://hh.ru/*",
        "https://*.hh.ru/*"
      ]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "HH Auto Otclicker"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
